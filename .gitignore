# Local instructions and task lists at any depth.
[Aa][Gg][Ee][Nn][Tt][Ss].[Mm][Dd]
[Tt][Oo][Dd][Oo].[Mm][Dd]

# Local cover artwork is never tracked.
/cover/

# Temporary artifacts must never be published or tracked.
_temp/
/test/

# Local game dumps and generated SDKs.
/Dump/

# Local tool installations and downloaded UE4SS distributions.
/_tools/
/UE4SS_v*/
/UE4SS_v*.zip
/zDEV-UE4SS_v*.zip
/userUE4SS/

# Generated files when opening Blueprint authoring projects locally.
/BPMod/*/Binaries/
/BPMod/*/Intermediate/
/BPMod/*/Saved/
/BPMod/*/DerivedDataCache/
/BPMod/*/.vs/
/BPMod/*/__pycache__/

# Local AutoSwitchWeapon editor configuration, not required by the mod.
/BPMod/AutoSwitchWeapon/Config/DefaultEngine.ini
/BPMod/AutoSwitchWeapon/Config/DefaultInput.ini
